node_modules/
data/
uploads/
.env
*.db
*.db-wal
*.db-shm
dist/

# Generated by npm run audit. Committing it makes the audit dirty the tree,
# which makes the self-test refuse to run right after it.
server/audit/last-run.json

# Backup artifacts. They contain password hashes and every private file byte.
server/backups/

# Archives, for the same reason and more sharply: an archive is a terminated
# customer's entire storage plus their password hash, sealed in one file. The
# handoff of 2026-09-07 said this directory was already ignored and it was not —
# a live terminate test put one into a commit before anybody noticed.
server/archives/

# What the distro matrix writes beside itself: one install log per flavour and the results.
server/tools/install-*.log
server/tools/matrix-results*.txt
server/tools/matrix-*.out
